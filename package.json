{
  "name": "ppptx-to-html",
  "version": "1.6.0",
  "description": "Offline PPTX to HTML desktop app, native CLI and browser converter",
  "scripts": {
    "build": "node scripts/build.mjs",
    "pretest": "node scripts/create-fixtures.cjs",
    "test": "node tests/offline.cjs && node tests/protection.cjs",
    "test:core": "node tests/conversion-core.cjs",
    "test:charts": "node scripts/create-fixtures.cjs && node tests/chart-data.cjs",
    "test:engine": "node scripts/create-fixtures.cjs && node tests/chart-engine.cjs",
    "test:fidelity": "node tests/fidelity.cjs",
    "test:links": "node tests/internal-links.cjs",
    "test:fixtures": "node scripts/create-fixtures.cjs",
    "test:protection": "node scripts/create-fixtures.cjs && node tests/protection.cjs",
    "convert": "node tools/convert-pptx.cjs",
    "check:native": "node tools/convert-pptx.cjs --check",
    "test:native": "node scripts/create-fixtures.cjs && node scripts/create-protected-fixtures.cjs && node tests/native-cli.cjs",
    "package:native": "node scripts/package-native-cli.cjs",
    "start": "node tools/serve-web.cjs",
    "start:web": "node tools/serve-web.cjs",
    "test:web": "node scripts/create-fixtures.cjs && node scripts/create-protected-fixtures.cjs && node tests/web-service.cjs",
    "package:desktop": "node scripts/package-desktop.cjs",
    "test:desktop": "node tests/desktop.cjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/1bobby-git/PPPTX_to_HTML.git"
  },
  "keywords": [],
  "author": "1bobby-git",
  "license": "MIT",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/1bobby-git/PPPTX_to_HTML/issues"
  },
  "homepage": "https://github.com/1bobby-git/PPPTX_to_HTML#readme",
  "dependencies": {
    "@briank-dev/pptx-to-html": "file:vendor/pptx2html-engine/briank-dev-pptx-to-html-2.1.0-ppptx.1.tgz",
    "busboy": "1.6.0",
    "cfb": "1.2.2",
    "dompurify": "3.4.17",
    "jsdom": "30.1.3",
    "jszip": "3.10.1",
    "officecrypto-tool": "0.0.19",
    "xml2js": "0.6.2"
  },
  "devDependencies": {
    "browserify": "17.0.1",
    "playwright": "1.62.1",
    "pptxgenjs": "4.0.1"
  },
  "private": true,
  "overrides": {
    "pptxgenjs": {
      "image-size": "2.0.4"
    }
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  }
}
