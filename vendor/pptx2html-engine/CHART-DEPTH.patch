+#[test]
+fn drawingml_chart_styles_do_not_corrupt_axis_classification() {
+    let styles = [
+        ("self-closing", r#"<c:spPr><a:noFill/></c:spPr>"#),
+        ("paired", r#"<c:spPr><a:noFill></a:noFill></c:spPr>"#),
+        (
+            "nested",
+            r#"<c:spPr><a:solidFill><a:srgbClr val="C0504D"/></a:solidFill></c:spPr>"#,
+        ),
+    ];
+    for (name, style) in styles {
+        let plot = family_plot("barChart").replacen("</c:tx>", &format!("</c:tx>{style}"), 1);
+        let xml = chart_space(&plot, axes()).replace(
+            "<c:chartSpace ",
+            "<c:chartSpace xmlns:a=\"http://schemas.openxmlformats.org/drawingml/2006/main\" ",
+        );
+        let result = convert_bytes_with_metadata(&package(Some(&xml), Some("rIdChart"), true))
+            .unwrap_or_else(|error| panic!("{name}: {error}"));
+        assert!(result.html.contains("class=\"chart-direct\""), "{name}");
+        assert!(
+            result.diagnostics.is_empty(),
+            "{name}: {:?}",
+            result.diagnostics
+        );
+    }
+}
+
+#[test]
+fn drawingml_chart_styles_do_not_accept_undefined_axes() {
+    let plot = family_plot("barChart")
+        .replacen(
+            "</c:tx>",
+            r#"</c:tx><c:spPr><a:solidFill><a:srgbClr val="C0504D"/></a:solidFill></c:spPr>"#,
+            1,
+        )
+        .replace("</c:barChart>", "<c:axId val=\"30\"/></c:barChart>");
+    let xml = chart_space(&plot, axes()).replace(
+        "<c:chartSpace ",
+        "<c:chartSpace xmlns:a=\"http://schemas.openxmlformats.org/drawingml/2006/main\" ",
+    );
+    let result = convert_bytes_with_metadata(&package(Some(&xml), Some("rIdChart"), true))
+        .expect("styled chart with an undefined axis returns a fallback");
+    assert!(!result.html.contains("class=\"chart-direct\""));
+    assert_eq!(result.diagnostics.len(), 1);
+    assert_eq!(result.diagnostics[0].code, "CHART_STRUCTURE_UNSUPPORTED");
+}
